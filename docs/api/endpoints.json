        {
          "id": "applications-store",
          "method": "POST",
          "path": "/applications",
          "summary": "Postular a una oferta (funcionalidad crítica)",
          "auth": true,
          "roles": [
            "Estudiante"
          ],
          "params": [],
          "body": [
            {
              "name": "offer_id",
              "in": "body",
              "type": "integer",
              "required": true,
              "description": "ID de una oferta aprobada.",
              "example": 3
            },
            {
              "name": "carta_motivacion",
              "in": "body",
              "type": "string",
              "required": true,
              "description": "Carta de motivación (máx. 10000 caracteres).",
              "example": "Me interesa esta práctica porque..."
            },
            {
              "name": "cv",
              "in": "body",
              "type": "file",
              "required": true,
              "description": "Currículum en PDF, DOC o DOCX (máx. 5 MB).",
              "example": "cv.pdf"
            }
          ],
          "body_type": "multipart",
          "responses": [
            {
