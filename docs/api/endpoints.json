    {
      "id": "auth",
      "name": "Autenticación (API privada)",
      "visibility": "private",
      "description": "La API privada usa tokens Bearer. Se obtiene un token con /auth/login y se envía en cada solicitud como  Authorization: Bearer <token>. El token dura 7 días y se puede revocar con /auth/logout. Login: máximo 10 intentos por minuto.",
      "endpoints": [
        {
          "id": "auth-login",
          "method": "POST",
          "path": "/auth/login",
          "summary": "Iniciar sesión y obtener token",
          "auth": false,
          "roles": [],
          "params": [],
          "body": [
            {
              "name": "email",
              "in": "body",
              "type": "string",
              "required": true,
              "description": "Correo del usuario.",
              "example": "juan@ucsc.cl"
            },
            {
              "name": "password",
              "in": "body",
              "type": "string",
              "required": true,
              "description": "Contraseña.",
              "example": "12345678"
            },
            {
              "name": "device_name",
              "in": "body",
              "type": "string",
              "required": false,
              "description": "Nombre del dispositivo (opcional).",
              "example": "postman"
            }
          ],
          "body_type": "json",
          "responses": [
            {
              "status": 200,
              "description": "Respuesta exitosa.",
              "example": {
                "token": "q8Wk...64 caracteres...Zr",
                "token_type": "Bearer",
                "expires_at": "2026-11-20T10:00:00-03:00",
                "user": {
                  "id": 2,
                  "name": "Juan",
                  "last_name": "Pérez",
                  "email": "juan@ucsc.cl",
                  "career_id": 1,
                  "roles": [
                    "Estudiante"
                  ]
                }
              }
            },
            {
              "status": 401,
              "description": "Credenciales incorrectas.",
              "example": {
                "message": "Credenciales inválidas."
              }
            },
            {
              "status": 422,
              "description": "Error de validación.",
              "example": {
                "message": "The hours field is required.",
                "errors": {
                  "hours": [
                    "The hours field is required."
                  ]
                }
              }
            }
          ],
          "idvar": null,
          "expect_status": 200,
          "expect_js": [
            "const j = pm.response.json();",
            "pm.test('entrega token Bearer', () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.token_type).to.eql('Bearer'); });",
            "pm.collectionVariables.set('token', j.token);"
          ],
          "note": "Usuarios de prueba (seeders), contraseña 12345678: admin@ucsc.cl (Administrador), juan@ucsc.cl y maria@ucsc.cl (Estudiante), coordinador@ucsc.cl (Coordinador), empresa@gmail.com (Empresa).",
          "curl": "curl -X POST \"__BASE__/auth/login\" \\\n  -H \"Accept: application/json\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"email\": \"juan@ucsc.cl\", \"password\": \"12345678\", \"device_name\": \"postman\"}'"
        },
        {
          "id": "auth-me",
          "method": "GET",
          "path": "/auth/me",
          "summary": "Datos del usuario autenticado",
          "auth": true,
          "roles": [],
          "params": [],
          "body": [],
          "body_type": null,
          "responses": [
            {
              "status": 200,
              "description": "Respuesta exitosa.",
              "example": {
                "data": {
                  "id": 2,
                  "name": "Juan",
                  "last_name": "Pérez",
                  "email": "juan@ucsc.cl",
                  "career_id": 1,
                  "roles": [
                    "Estudiante"
                  ]
                }
              }
            },
            {
              "status": 401,
              "description": "Token ausente, inválido o expirado.",
              "example": {
                "message": "Token inválido o expirado."
              }
            }
          ],
          "idvar": null,
          "expect_status": 200,
          "expect_js": [
            "pm.test('devuelve roles', () => pm.expect(pm.response.json().data.roles).to.be.an('array'));"
          ],
          "note": null,
          "curl": "curl -X GET \"__BASE__/auth/me\" \\\n  -H \"Authorization: Bearer <TOKEN>\" \\\n  -H \"Accept: application/json\""
        },
        {
          "id": "auth-logout",
          "method": "POST",
          "path": "/auth/logout",
          "summary": "Cerrar sesión (revoca el token actual)",
          "auth": true,
          "roles": [],
          "params": [],
          "body": [],
          "body_type": null,
          "responses": [
            {
              "status": 200,
              "description": "Respuesta exitosa.",
              "example": {
                "message": "Sesión cerrada. El token fue revocado."
              }
            },
            {
              "status": 401,
              "description": "Token ausente, inválido o expirado.",
              "example": {
                "message": "Token inválido o expirado."
              }
            }
          ],
          "idvar": null,
          "expect_status": 200,
          "expect_js": [],
          "note": "En Postman, después de ejecutar este request vuelve a ejecutar el login para obtener un token nuevo.",
          "curl": "curl -X POST \"__BASE__/auth/logout\" \\\n  -H \"Authorization: Bearer <TOKEN>\" \\\n  -H \"Accept: application/json\""
        }
      ]
    },
    {
      "id": "private-applications",
      "name": "API Privada 1 · Postulaciones",
      "visibility": "private",
      "description": "Gestión de postulaciones a ofertas. Cada rol solo ve lo suyo: el estudiante sus postulaciones, el coordinador las de su carrera, la empresa las de sus ofertas y el administrador todas.",
