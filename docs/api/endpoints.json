{
  "info": {
    "title": "API REST · Plataforma de Prácticas Profesionales",
    "version": "v1",
    "base_url": "http://127.0.0.1:8000/api/v1",
    "description": "API REST en JSON del sistema de gestión de prácticas (Laravel). Incluye 2 APIs públicas y 2 privadas. Todas las respuestas son JSON; los errores de validación devuelven 422 con el detalle por campo."
  },
  "groups": [
    {
      "id": "public-offers",
      "name": "API Pública 1 · Ofertas de práctica",
      "visibility": "public",
      "description": "Consulta abierta (sin token) de las ofertas de práctica que ya fueron aprobadas por coordinación. Límite: 60 solicitudes por minuto por IP.",
      "endpoints": [
        {
          "id": "offers-list",
          "method": "GET",
          "path": "/public/offers",
          "summary": "Listar ofertas aprobadas",
          "auth": false,
          "roles": [],
          "params": [
            {
              "name": "search",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Texto a buscar en título, empresa o área.",
              "example": "desarrollo"
            },
            {
              "name": "career_id",
              "in": "query",
              "type": "integer",
              "required": false,
              "description": "Solo ofertas dirigidas a esta carrera.",
              "example": 1
            },
            {
              "name": "modalidad",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Presencial, Remota o Híbrida.",
              "example": "Híbrida"
            },
            {
              "name": "area",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Área de la oferta (búsqueda parcial).",
              "example": "Tecnología"
            },
            {
              "name": "ubicacion",
              "in": "query",
              "type": "string",
              "required": false,
              "description": "Ciudad o región (búsqueda parcial).",
              "example": "Concepción"
            },
            {
              "name": "per_page",
              "in": "query",
              "type": "integer",
              "required": false,
              "description": "Resultados por página (1 a 50, por defecto 10).",
              "example": 10
            },
            {
              "name": "page",
              "in": "query",
              "type": "integer",
              "required": false,
              "description": "Número de página.",
              "example": 1
            }
          ],
          "body": [],
          "body_type": null,
          "responses": [
            {
              "status": 200,
              "description": "Respuesta exitosa.",
              "example": {
                "data": [
                  {
                    "id": 3,
                    "titulo": "Practicante de Desarrollo Web",
                    "empresa": "TechSur SpA",
                    "area": "Tecnología",
                    "modalidad": "Híbrida",
                    "ubicacion": "Concepción",
                    "duracion_semanas": 16,
                    "vacantes": 2,
                    "vacantes_disponibles": 2,
                    "carreras": [
                      {
                        "id": 1,
                        "nombre": "Ingeniería Civil Informática"
                      }
                    ]
                  }
                ],
                "meta": {
                  "total": 12,
                  "page": 1,
                  "per_page": 10,
                  "last_page": 2
                }
              }
            },
            {
              "status": 422,
              "description": "Error de validación.",
              "example": {
                "message": "The hours field is required.",
                "errors": {
                  "hours": [
                    "The hours field is required."
                  ]
                }
              }
            }
          ],
          "idvar": null,
          "expect_status": 200,
          "expect_js": [
            "const j = pm.response.json();",
            "pm.test('incluye data y meta', () => { pm.expect(j).to.have.property('data'); pm.expect(j).to.have.property('meta'); });",
            "if (j.data.length) { pm.collectionVariables.set('offer_id', j.data[0].id); }"
          ],
          "note": null,
          "curl": "curl -X GET \"__BASE__/public/offers?search=desarrollo&career_id=1\" \\\n  -H \"Accept: application/json\""
        },
        {
          "id": "offers-show",
          "method": "GET",
          "path": "/public/offers/{id}",
          "summary": "Detalle de una oferta aprobada",
          "auth": false,
          "roles": [],
          "params": [
            {
              "name": "id",
              "in": "path",
              "type": "integer",
              "required": true,
              "description": "ID de la oferta.",
              "example": 3
            }
          ],
          "body": [],
          "body_type": null,
          "responses": [
            {
              "status": 200,
              "description": "Respuesta exitosa.",
              "example": {
                "data": {
                  "id": 3,
                  "titulo": "Practicante de Desarrollo Web",
                  "empresa": "TechSur SpA",
                  "area": "Tecnología",
                  "modalidad": "Híbrida",
                  "ubicacion": "Concepción",
                  "duracion_semanas": 16,
                  "vacantes": 2,
                  "vacantes_disponibles": 2,
                  "carreras": [
                    {
                      "id": 1,
                      "nombre": "Ingeniería Civil Informática"
                    }
                  ],
                  "perfil": "Estudiante de 4.º año con conocimientos de Laravel.",
                  "nivel_requerido": "Avanzado",
                  "promedio_minimo": 5.0,
                  "horario": "Lunes a viernes 9:00–14:00",
                  "remuneracion": 250000.0,
                  "habilidades": [
                    "PHP",
                    "Laravel",
                    "MySQL"
                  ],
                  "rubro_empresa": "Software"
                }
              }
            },
            {
              "status": 404,
              "description": "Oferta no existe o no es visible para el usuario.",
              "example": {
                "message": "Oferta no encontrada."
              }
            }
          ],
          "idvar": "offer_id",
          "expect_status": 200,
          "expect_js": [
            "pm.test('tiene id y título', () => { const d = pm.response.json().data; pm.expect(d).to.have.property('id'); pm.expect(d).to.have.property('titulo'); });"
          ],
          "note": null,
          "curl": "curl -X GET \"__BASE__/public/offers/{id}\" \\\n  -H \"Accept: application/json\""
        }
      ]
    },
