  "item": [
    {
      "name": "API Pública 1 · Ofertas de práctica",
      "description": "Consulta abierta (sin token) de las ofertas de práctica que ya fueron aprobadas por coordinación. Límite: 60 solicitudes por minuto por IP.",
      "item": [
        {
          "name": "GET /public/offers — Listar ofertas aprobadas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/public/offers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "offers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "desarrollo",
                  "disabled": true
                },
                {
                  "key": "career_id",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "modalidad",
                  "value": "Híbrida",
                  "disabled": true
                },
                {
                  "key": "area",
                  "value": "Tecnología",
                  "disabled": true
                },
                {
                  "key": "ubicacion",
                  "value": "Concepción",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "10",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                }
              ]
            },
            "description": "Listar ofertas aprobadas",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde en JSON', () => pm.response.to.be.json);",
                  "const j = pm.response.json();",
                  "pm.test('incluye data y meta', () => { pm.expect(j).to.have.property('data'); pm.expect(j).to.have.property('meta'); });",
                  "if (j.data.length) { pm.collectionVariables.set('offer_id', j.data[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /public/offers/{id} — Detalle de una oferta aprobada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/public/offers/{{offer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "offers",
                "{{offer_id}}"
              ]
            },
            "description": "Detalle de una oferta aprobada",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde en JSON', () => pm.response.to.be.json);",
                  "pm.test('tiene id y título', () => { const d = pm.response.json().data; pm.expect(d).to.have.property('id'); pm.expect(d).to.have.property('titulo'); });"
                ]
              }
            }
          ]
        }
      ]
    },
