        {
          "name": "POST /applications — Postular a una oferta (funcionalidad crítica)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/applications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "applications"
              ]
            },
            "description": "Postular a una oferta (funcionalidad crítica)\n\nSe envía como multipart/form-data. En Postman, selecciona un archivo en el campo «cv» antes de enviar.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "offer_id",
                  "value": "{{offer_id}}",
                  "type": "text"
                },
                {
                  "key": "carta_motivacion",
                  "value": "Me interesa esta práctica porque...",
                  "type": "text"
                },
                {
                  "key": "cv",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Responde en JSON', () => pm.response.to.be.json);",
                  "pm.test('postulación creada en estado Postulado', () => pm.expect(pm.response.json().data.estado).to.eql('Postulado'));",
                  "pm.collectionVariables.set('new_application_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /applications/{id} — Retirar una postulación propia",
