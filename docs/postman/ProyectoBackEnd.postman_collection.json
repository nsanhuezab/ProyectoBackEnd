    {
      "name": "Autenticación (API privada)",
      "description": "La API privada usa tokens Bearer. Se obtiene un token con /auth/login y se envía en cada solicitud como  Authorization: Bearer <token>. El token dura 7 días y se puede revocar con /auth/logout. Login: máximo 10 intentos por minuto.",
      "item": [
        {
          "name": "POST /auth/login — Iniciar sesión y obtener token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Iniciar sesión y obtener token\n\nUsuarios de prueba (seeders), contraseña 12345678: admin@ucsc.cl (Administrador), juan@ucsc.cl y maria@ucsc.cl (Estudiante), coordinador@ucsc.cl (Coordinador), empresa@gmail.com (Empresa).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde en JSON', () => pm.response.to.be.json);",
                  "const j = pm.response.json();",
                  "pm.test('entrega token Bearer', () => { pm.expect(j.token).to.be.a('string'); pm.expect(j.token_type).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me — Datos del usuario autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Datos del usuario autenticado"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde en JSON', () => pm.response.to.be.json);",
                  "pm.test('devuelve roles', () => pm.expect(pm.response.json().data.roles).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
